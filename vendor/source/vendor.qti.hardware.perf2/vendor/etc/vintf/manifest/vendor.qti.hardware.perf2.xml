<manifest version="1.0" type="device">
  <!-- 3a-16 收编的官方 QTI perf2 HAL（背景见同目录 build.py）。
       官方 system 的 compatibility_matrix.device.xml 将其列为必需 HAL；缺失会让
       BoostFramework 的连接调用永久阻塞在 vendor.perfservice 上。 -->
  <hal format="aidl">
    <name>vendor.qti.hardware.perf2</name>
    <fqname>IPerf/default</fqname>
  </hal>
</manifest>
