# note13-5G-15 自研 lights HAL（虚拟 HAL）。
#
# lineage 底座没有 lights HAL：vendor VINTF 未声明 android.hardware.light.ILights，
# LightsService 因此既拿不到 aidl 实例、Lights 列表也为空。
# 本服务接管 android.hardware.light.ILights/default，按真机（MTK lights HAL）的
# id/ordinal/type 八盏灯清单（config/lights.json）上报；setLightState 只记录状态，
# 不驱动宿主屏幕亮度，也不写 guest sysfs LED。
service vendor.cdh_note13_lights /vendor/bin/hw/android.hardware.lights-service.cdh-note13
    class hal
    user system
    group system
    seclabel u:r:hal_light_default:s0
    interface aidl android.hardware.light.ILights/default
    shutdown critical
    disabled

on post-fs-data
    start vendor.cdh_note13_lights
