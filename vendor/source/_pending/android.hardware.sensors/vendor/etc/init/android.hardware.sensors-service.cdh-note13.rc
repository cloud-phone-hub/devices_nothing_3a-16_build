# note13-5G-15 自研 sensors HAL（虚拟 HAL）。
#
# lineage 底座没有 sensors HAL：/vendor/bin/hw 无 sensors 服务、vendor VINTF 与
# vendor_service_contexts 也没有对应表项，SensorService 起不来
# （dumpsys sensorservice = "No Sensors on the device", devInitCheck = -19）。
# 本服务接管 android.hardware.sensors.ISensors/default，上报 note13 真机的传感器
# 清单（config/sensors.json）并通过 FMQ 生成虚拟事件流。
service vendor.cdh_note13_sensors /vendor/bin/hw/android.hardware.sensors-service.cdh-note13
    class hal
    user system
    group system
    rlimit rtprio 10 10
    seclabel u:r:hal_sensors_default:s0
    interface aidl android.hardware.sensors.ISensors/default
    disabled

on post-fs-data
    start vendor.cdh_note13_sensors
