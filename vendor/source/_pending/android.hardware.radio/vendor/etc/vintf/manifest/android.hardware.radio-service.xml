<manifest version="1.0" type="device">
  <hal format="aidl">
    <name>android.hardware.radio.config</name>
    <version>3</version>
    <fqname>IRadioConfig/default</fqname>
  </hal>
  <hal format="aidl">
    <name>android.hardware.radio.data</name>
    <version>3</version>
    <fqname>IRadioData/slot1</fqname>
    <fqname>IRadioData/slot2</fqname>
  </hal>
  <hal format="aidl">
    <name>android.hardware.radio.messaging</name>
    <version>3</version>
    <fqname>IRadioMessaging/slot1</fqname>
    <fqname>IRadioMessaging/slot2</fqname>
  </hal>
  <hal format="aidl">
    <name>android.hardware.radio.modem</name>
    <version>3</version>
    <fqname>IRadioModem/slot1</fqname>
    <fqname>IRadioModem/slot2</fqname>
  </hal>
  <hal format="aidl">
    <name>android.hardware.radio.network</name>
    <version>3</version>
    <fqname>IRadioNetwork/slot1</fqname>
    <fqname>IRadioNetwork/slot2</fqname>
  </hal>
  <hal format="aidl">
    <name>android.hardware.radio.sim</name>
    <version>3</version>
    <fqname>IRadioSim/slot1</fqname>
    <fqname>IRadioSim/slot2</fqname>
  </hal>
  <hal format="aidl">
    <name>android.hardware.radio.voice</name>
    <version>3</version>
    <fqname>IRadioVoice/slot1</fqname>
    <fqname>IRadioVoice/slot2</fqname>
  </hal>
  <!-- dsds：与 gold 真机一致，每个接口声明 slot1/slot2 两个实例（框架按
       IRadioConfig.getPhoneCapability 的 modem 数各建一条 Phone，分别连自己的
       slot 实例），基带版本按槽从 gsm.version.baseband 列表取。 -->
  <!-- MTK radioex：只声明 sim（与 gold /vendor/etc/vintf/manifest.xml 的
       vendor.mediatek.hardware.mtkradioex.sim 条目同版本 2）。
       gold MIUI/MTK RIL 用 waitForDeclaredService 取 radioex 代理，故 sim 必须
       declared 才能让 MtkRIL 握手并收到我们的 iccidChanged —— MTK 的
       MtkUiccController.mIccid[] 只有 iccidChanged 一条写入路径，而它是短信/订阅
       服务 SMSVC 的订阅门禁 checkAllIccIdReady 的唯一数据源（空值则永不建订阅）。
       其余 radioex 名字（data/messaging/modem/network/voice）保持不声明：那些名字
       上挂的是标准 radio 服务的别名 binder（仅为满足 isRildReady 的 checkService
       轮询），一旦 declared，waitForDeclaredService 会把别名当 radioex 接口调用，
       事务码整体错位导致 com.android.phone 反复崩溃。sim 无此问题（真实现）。 -->
  <hal format="aidl">
    <name>vendor.mediatek.hardware.mtkradioex.sim</name>
    <version>2</version>
    <fqname>IMtkRadioExSim/slot1</fqname>
    <fqname>IMtkRadioExSim/slot2</fqname>
  </hal>
</manifest>
